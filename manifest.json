{
  "manifestVersion": "1",
  "title": "Tic-Tac-Toe",
  "shortDescription": "Three in a row wins. The classic two-player game on a 3×3 grid.",
  "version": "1.0.0",
  "gdkApiVersion": "0.1.0",
  "runtime": "jvm",
  "backend": { "path": "backend/tictactoe.jar", "entryPoint": "io.turnbase.games.tictactoe.TicTacToeGame" },
  "frontend": { "entryPoint": "frontend/main.js" },
  "infoDoc": "INFO.md",
  "tags": ["classic", "strategy", "two-player"],
  "capabilities": { "ai": false, "spectators": true, "midGameJoin": false },
  "teamTemplates": [
    { "name": "X", "size": { "min": 1, "max": 1 }, "count": { "min": 1, "max": 1 } },
    { "name": "O", "size": { "min": 1, "max": 1 }, "count": { "min": 1, "max": 1 } }
  ]
}
