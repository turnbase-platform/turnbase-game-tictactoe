{
  "name": "turnbase-game-tictactoe-frontend",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Tic-Tac-Toe game frontend — bundled to frontend/main.js in the game bundle.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "esbuild src/main/ts/main.ts --bundle --format=esm --target=es2022 --minify --outfile=target/bundle/frontend/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/main/ts src/test/ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --coverage",
    "licenses": "npx --yes license-checker-rseidelsohn@5.0.1 --production --excludePrivatePackages --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;OFL-1.1' --excludePackages '@turnbase-platform/gdk@0.1.0' --csv --out licenses.csv"
  },
  "dependencies": {
    "@turnbase-platform/gdk": "https://github.com/turnbase-platform/turnbase-sdk/releases/download/v0.1.0/turnbase-platform-gdk-0.1.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.12",
    "ws": "8.21.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
